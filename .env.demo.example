# Demo-only environment for the single-VM deployment. Copy to `.env.demo`,
# generate every secret, and never commit the resulting file.

# A real hostname pointing to the VM. A free DNS hostname is sufficient.
DOMAIN=nexora-demo.example.com
CORS_ORIGINS=https://nexora-demo.example.com

# Generate independently; do not reuse values across variables.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
BFF_SESSION_SECRET=
DEMO_ACCOUNT_EMAIL=demo@nexora.ai
# Published demo-only password; never reuse it for a real user or production tenant.
DEMO_ACCOUNT_PASSWORD=NexoraDemo!2026
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

POSTGRES_DB=nexora
POSTGRES_USER=nexora_owner
POSTGRES_APP_USER=nexora_app

# Mailpit exists only in docker-compose.demo.yml and remains private.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Non-empty because the production config contract requires credentials.
# Mailpit accepts these demo-only values on the private Compose network.
SMTP_USER=demo
SMTP_PASSWORD=demo
SMTP_TLS=false
EMAIL_FROM=no-reply@nexora-demo.example.com

# Full document scanning remains enabled in the demo.
ANTIVIRUS_ENABLED=true

# AI/RAG providers are optional. Qdrant itself remains deployed even when no
# paid LLM key is configured.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
