# Template for `docker-compose.prod.yml`. Copy to `.env` in the repo root
# (Compose loads it automatically) and fill in every value — each one is
# required with no fallback; `docker compose up` refuses to start with any
# of these unset rather than silently running a dev default in production.
# See docs/DEPLOYMENT.md.

# ─── Domain ─────────────────────────────────────────────────────────────────
# Must already resolve (an A/AAAA record) to this host before starting the
# stack — Caddy requests a Let's Encrypt certificate for it on first boot.
DOMAIN=

# ─── Secrets — generate fresh values, never reuse the ones in .env.example ──
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every encrypted field (MFA secrets) permanently
# undecryptable. Back it up somewhere that is not this .env file.
FIELD_ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
BFF_SESSION_SECRET=

# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_DB=nexora
POSTGRES_USER=nexora_owner
POSTGRES_PASSWORD=
POSTGRES_APP_USER=nexora_app
POSTGRES_APP_PASSWORD=

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── CORS ───────────────────────────────────────────────────────────────────
# Your real origin(s), comma-separated. "*" is rejected at startup.
CORS_ORIGINS=https://your-domain.example

# ─── Email — a real relay. mailhog is dev-only and is not part of this
# compose file at all. ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=no-reply@your-domain.example

# ─── Object storage (MinIO, self-hosted by this compose file) ──────────────
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── AI / RAG — optional. Omit both and the deployment runs with AI features
# unavailable rather than failing to start (AI.md §2.6). ────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Virus scanning — optional, off by default (SECURITY.md §12). The
# `clamav` service always starts; this only decides whether uploads are
# routed through it. ─────────────────────────────────────────────────────────
ANTIVIRUS_ENABLED=false
