# Nexora AI — configuration contract
# Copy to .env and fill in. NEVER commit .env.
# Every variable the application reads must appear here.
# Settings validation fails fast at startup if a required variable is missing.

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | staging | production
DEBUG=true                              # MUST be false outside development
APP_NAME=Nexora AI
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                         # json | console (console for local only)

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. No default. Minimum 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=nexora_rt
REFRESH_COOKIE_SECURE=false             # MUST be true in any non-local environment
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth

PASSWORD_MIN_LENGTH=12
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536                # KiB — 64 MiB per concurrent hash
ARGON2_PARALLELISM=4

EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
INVITATION_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Explicit origins only. "*" with credentials is invalid and is a P0 finding.
CORS_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# The application connects as a NON-OWNER role so RLS policies actually apply.
DATABASE_URL=postgresql+asyncpg://nexora_app:nexora_app_pw@postgres:5432/nexora
DATABASE_URL_SYNC=postgresql+psycopg://nexora_app:nexora_app_pw@postgres:5432/nexora
DATABASE_OWNER_URL=postgresql+psycopg://nexora_owner:nexora_owner_pw@postgres:5432/nexora
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false                           # never true outside local debugging

POSTGRES_DB=nexora
POSTGRES_USER=nexora_owner
POSTGRES_PASSWORD=nexora_owner_pw
POSTGRES_APP_USER=nexora_app
POSTGRES_APP_PASSWORD=nexora_app_pw

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:nexora_redis_pw@redis:6379/0
REDIS_PASSWORD=nexora_redis_pw
RATE_LIMIT_ENABLED=true

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:nexora_redis_pw@redis:6379/1
CELERY_RESULT_BACKEND=redis://:nexora_redis_pw@redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false          # true only in tests

# ─── Object storage (S3-compatible; MinIO in dev) ─────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=nexora-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false
S3_PRESIGNED_URL_EXPIRE_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=26214400          # 25 MiB
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,xlsx,csv,txt,md,png,jpg,jpeg
ANTIVIRUS_ENABLED=false

# ─── Qdrant (Phase 9) ─────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nexora_documents
EMBEDDING_DIMENSIONS=1024

# ─── AI (Phases 8–10) ─────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_CHAT=claude-sonnet-5
LLM_MODEL_ANALYSIS=claude-opus-5
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
AI_MAX_DATE_RANGE_DAYS=366
AI_TENANT_MONTHLY_TOKEN_BUDGET=2000000

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=no-reply@nexora.local
EMAIL_FROM_NAME=Nexora AI

# ─── Observability ────────────────────────────────────────────────────────────
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_* is exposed to the browser. Never put a secret in one.
NEXT_PUBLIC_APP_NAME=Nexora AI
NEXT_PUBLIC_API_BASE_URL=/api/bff
BACKEND_INTERNAL_URL=http://backend:8000
# REQUIRED in production. Generate as for JWT_SECRET_KEY.
BFF_SESSION_SECRET=
BFF_REDIS_URL=redis://:nexora_redis_pw@redis:6379/3
# Single-flight refresh bounds, in milliseconds. These are defaults; override
# only together. The app refuses to start unless
#   BFF_REFRESH_TIMEOUT_MS < BFF_REFRESH_LOCK_TTL_MS < BFF_REFRESH_WAIT_MS
# A refresh that outlives the lock lets a second request replay the same
# rotating token (reuse detection then revokes the family); a waiter that gives
# up before the lock expires reads a slow-but-successful refresh as a dead
# session and logs the user out. Both are real, both were shipped once.
BFF_REFRESH_TIMEOUT_MS=10000
BFF_REFRESH_LOCK_TTL_MS=15000
BFF_REFRESH_WAIT_MS=20000
